# Craig docker-compose secrets
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# The .env file is read automatically by docker-compose.
# Never commit the real .env file.

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
# Optional: sync slash commands to a single guild during development
DEVELOPMENT_GUILD_ID=

# ── Download domain ───────────────────────────────────────────────────────────
# Protocol and domain of the public-facing download API
# e.g. DOWNLOAD_PROTOCOL=https  DOWNLOAD_DOMAIN=craig.example.com
DOWNLOAD_PROTOCOL=https
DOWNLOAD_DOMAIN=localhost:5029

# ── Dashboard OAuth ───────────────────────────────────────────────────────────
CLIENT_ID=
CLIENT_SECRET=
# Public URL of the dashboard
APP_URI=http://localhost:3000
# Random secret for JWT signing (generate: openssl rand -hex 32)
JWT_SECRET=

# ── Patreon (optional) ────────────────────────────────────────────────────────
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATRON_TIER_MAP=
PATREON_WEBHOOK_SECRET=

# ── Google Drive (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft OneDrive (optional) ─────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Dropbox (optional) ────────────────────────────────────────────────────────
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# ── Notion integration (optional) ────────────────────────────────────────────
NOTION_TOKEN=

# ── Download API settings ─────────────────────────────────────────────────────
API_PORT=5029
API_HOMEPAGE=https://localhost:5029/
ENNUIZEL_BASE=https://ez.craig.horse/
TRUST_PROXY=

# ── Observability (all optional) ──────────────────────────────────────────────
SENTRY_DSN=
SENTRY_HOST=
SENTRY_SAMPLE_RATE=1.0
SENTRY_DSN_API=
SENTRY_ENV=
SENTRY_SAMPLE_RATE_API=1.0
INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=
SERVER_NAME=craig
